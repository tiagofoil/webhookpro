# Upstash Redis REST credentials.
# The app accepts any ONE of these pairs (checked in this order):
#
#   1. UPSTASH_REDIS_REST_URL       / UPSTASH_REDIS_REST_TOKEN        (Upstash native)
#   2. KV_REST_API_URL              / KV_REST_API_TOKEN               (Vercel Marketplace)
#   3. UPSTASH_REDIS_REST_KV_REST_API_URL / ..._TOKEN                 (Vercel integration w/ prefix)
#
# The URL must be the REST endpoint (https://...upstash.io), NOT a redis:// string.
# Check what the running deployment actually sees at GET /api/health.

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Public base URL used to build the returned webhook/view links.
NEXT_PUBLIC_APP_URL=https://webhookpro.ai-foil.com
